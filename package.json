{
  "name": "harness",
  "private": true,
  "description": "Harness: a multiplayer coordination layer for humans and AI agents. See PLAN.md.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\" \"packages/*/test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "server": "node packages/server/src/main.ts",
    "daemon": "node packages/daemon/src/main.ts",
    "demo": "node scripts/demo-0a.ts",
    "demo:0b": "node scripts/demo-0b.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
